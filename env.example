# Required in production: a long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me
PORT=3000
# Where the SQLite file lives. On Render, point this at a persistent disk if you add one.
DB_PATH=./data/chaupal.db
# Max people per room (mesh WebRTC works best up to ~6)
MAX_ROOM_SIZE=6
# Optional TURN server for strict networks (Metered.ca / Open Relay free tier etc.)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
